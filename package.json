{
  "name": "apollo-config-client",
  "version": "1.0.0",
  "description": "Apollo (Ctrip) configuration center client with accesskey signature support. Drop-in replacement for node-apollo with zero runtime dependencies; ships long polling, local cache, grayscale IP, meta service discovery and change callbacks.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "apollo",
    "ctrip-apollo",
    "apollo-config",
    "accesskey",
    "config-center",
    "configuration",
    "long-polling",
    "hot-update",
    "local-cache",
    "grayscale"
  ],
  "author": "liuleiyu",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuleiyu121520/apollo-config-client.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node-apollo": "1.2.1",
    "typescript": "^5.5.0"
  }
}
